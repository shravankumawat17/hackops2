# BACKEND ONLY. Copy the Session pooler URI from your project's Connect panel.
# URL-encode password characters; never commit the resulting .env file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# FastAPI only: explicitly allow your frontend development origin.
FRONTEND_ORIGIN=http://localhost:5173
# FRONTEND: only a public API base URL, never a database password.
VITE_API_BASE_URL=http://localhost:8000/api
# For a Next.js frontend use NEXT_PUBLIC_API_BASE_URL instead of VITE_API_BASE_URL.
